{
  "name": "@supermemory/eve",
  "version": "0.1.2",
  "description": "Durable user context, retrieval, extraction, remembering, and forgetting for Eve agents.",
  "type": "module",
  "files": [
    "dist"
  ],
  "keywords": [
    "agents",
    "eve",
    "memory",
    "supermemory"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prebuild": "npm run clean",
    "build": "tsc -p tsconfig.build.json",
    "check": "biome ci src evals tests",
    "format": "biome format --write src evals tests",
    "test": "node --import ./tests/resolve-ts.mjs --test tests/*.test.ts",
    "supermemory:up": "node scripts/local-supermemory.mjs up",
    "supermemory:down": "node scripts/local-supermemory.mjs down",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "supermemory": "^4.25.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/node": "24.x",
    "eve": "0.66.1",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "eve": ">=0.47.3 <1"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  }
}
